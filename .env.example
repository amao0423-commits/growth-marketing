# Supabase（プロジェクト作成後、Project Settings > API から取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role キー。絶対にNEXT_PUBLIC_を付けない・ブラウザに露出させないこと。
SUPABASE_SERVICE_ROLE_KEY=

# 各OAuthプロバイダ（Supabase Auth > Providers 側にも同じ値を登録する）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINE_OAUTH_CLIENT_ID=
LINE_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# AI審査（本格版・後回し）。ルールベース段階では未使用。
ANTHROPIC_API_KEY=

# サイトURL（canonical/OGP生成用）
NEXT_PUBLIC_SITE_URL=https://www.nishinippon-adv.jp

# フォーム受信メール（/report/ と /ad/apply/ の通知先）。
# RESEND_API_KEY が未設定だとフォーム送信は502を返す（＝「受け付けました」と偽らない）。
# MAIL_FROM のドメインは Resend 側で認証済みである必要がある。
RESEND_API_KEY=
MAIL_FROM=アドプレス <noreply@nishinippon-adv.jp>
MAIL_TO=info@cocomake-guide.com

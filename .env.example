# Supabase（プロジェクト作成後、Project Settings > API から取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role キー。絶対にNEXT_PUBLIC_を付けない・ブラウザに露出させないこと。
SUPABASE_SERVICE_ROLE_KEY=

# 各OAuthプロバイダ（Supabase Auth > Providers 側にも同じ値を登録する）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINE_OAUTH_CLIENT_ID=
LINE_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# AI審査（本格版・後回し）。ルールベース段階では未使用。
ANTHROPIC_API_KEY=

# サイトURL（canonical/OGP生成用）
NEXT_PUBLIC_SITE_URL=https://www.nishinippon-adv.jp

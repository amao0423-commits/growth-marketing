{
  "name": "adpress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "アドプレス（ADPRESS）— 編集部が確認したプレスリリースやニュースを掲載するメディア。Next.js + Supabase。",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "opennextjs-cloudflare build --skipWranglerConfigCheck",
    "start": "next start",
    "lint": "next lint",
    "generate": "node scripts/generate-post.mjs",
    "migrate:legacy": "tsx scripts/migrate-legacy-articles.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
